APP_PORT=8080
GITHUB_TOKEN=
REDIS_URL=redis://localhost:6379/0
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen3:latest
OLLAMA_THINKING=false
OLLAMA_NUM_PREDICT=128
LLM_TIMEOUT_SECONDS=20
MAX_CONTEXT_SIZE=8000
LLM_TEMPERATURE=0.6
LLM_TOP_P=0.95
LLM_TOP_K=20
VLLM_MODEL=Qwen/Qwen3-4B-Instruct-2507
GITHUB_TIMEOUT_SECONDS=15
LLM_TIMEOUT_SECONDS=20
MAX_ISSUES=30
MAX_IMPORTANT_FILES=24
MAX_FILE_SIZE=200000
MAX_README_SIZE=100000
MAX_CONTEXT_SIZE=8000
MAX_TREE_ENTRIES=50000
MAX_GITHUB_REQUESTS_PER_ANALYSIS=32
MAX_ANALYSIS_TIME=120
ANALYZE_RATE_LIMIT_PER_IP=10
ANALYZE_RATE_LIMIT_WINDOW=3600
MAX_CONCURRENT_ANALYSES=4
ANALYSIS_CACHE_FRESH_SECONDS=60
ANALYSIS_CACHE_TTL_SECONDS=600
POSTGRES_PASSWORD=change-this-before-deployment
